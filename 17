#include <iostream>
using namespace std;

int main() {
    setlocale(0, "");

    int vibor, razmer;
    char tekstura;

    
    cout << "[ + ] Программа - \"Геометрические фигуры\"\n";
    cout << "[ 5 ] Решетка\n";
    cout << "[ 6 ] Крестик\n";
    cout << "[ + ] Выберите фигуру: ";
    cin >> vibor;

    if (vibor == 6) {
        system("cls");

        cout << "[ + ] Фигура: \"Крестик\"\n\n";
        cout << "[ + ] Размер: ";
        cin >> razmer;
        cout << "\n[ + ] Текстура: ";
        cin >> tekstura;

        cout << "\n[ + ] Результат:\n\n";

        
        for (int i = 0; i < razmer; i++) {
            for (int j = 0; j < razmer; j++) {
                if (i == j || i + j == razmer - 1) 
                    cout << tekstura << "  ";
                else
                    cout << ".  ";
            }
            cout << "\n\n";
        }
    }

    return 0;
}
