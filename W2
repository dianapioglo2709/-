#include <iostream>
using namespace std;

int main() {
    setlocale(0, "");
    int number;

    cout << "[ + ] Введите число: ";
    cin >> number;

    if (number <= 0) {
        cout << "Число должно быть положительным!" <<endl;
        return 0;
    }

    cout << "\n";
    while (number > 0) {
        cout << "Отсчет:  " << number <<endl;
        number--;
    }

    cout << "\n[ + ] Старт!" <<endl;

    return 0;
}
