#include <iostream>
using namespace std;

int main() {
    setlocale(0, "");
    int number;
    int count = 0;
    cout << "[ + ] Введите число: ";
    cin >> number;

    
    if (number < 0) {
        cout << "Введите положительное число!" << endl;
        return 0;
    }

   
    if (number == 0) {
        count = 1; 
    }
    else {
        int mint = number; 
        while (mint > 0) {
            count++;           
            mint = mint / 10;  
        }
    }

   
    cout << "[ + ] Количество цифр: " << count << endl;

    return 0;
}
